  "panels": [
    {
      "id": 1,
      "title": "Throughput da ingest\u00e3o \u2014 registros/s",
      "description": "Linhas validadas / dura\u00e7\u00e3o de extra\u00e7\u00e3o e escrita Delta. N\u00e3o inclui inicializa\u00e7\u00e3o, planejamento ou leitura de valida\u00e7\u00e3o.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "company_ingestion_throughput_rows_per_second{engine=~\"$engine\",table=~\"$table\",profile=~\"$profile\"}",
          "legendFormat": "{{engine}} / {{read_mode}} / {{table}} / {{profile}} / {{run_id}}",
          "refId": "A",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rps",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },

{
  "uid": "company-spark",
  "title": "Company Ingestion \u2014 Spark \u00d7 dltHub",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
